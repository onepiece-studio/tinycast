    "This Week": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周"
          }
        }
      }
    },
    "This backup contains %@ and %@. Custom commands can run arbitrary shell code. Only import files you trust.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This backup contains %1$@ and %2$@. Custom commands can run arbitrary shell code. Only import files you trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份包含 %@ 和 %@。自定义命令可以运行任意 Shell 代码，请仅导入你信任的文件。"
          }
        }
      }
    },
    "This backup was made by a different version of Tinycast (format %lld, expected %lld). Export again from the Mac that has your setup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This backup was made by a different version of Tinycast (format %1$lld, expected %2$lld). Export again from the Mac that has your setup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份由其他版本的 Tinycast 创建（格式为 %lld，预期为 %lld）。请在保存了原有配置的 Mac 上重新导出。"
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。"
          }
        }
      }
    },
