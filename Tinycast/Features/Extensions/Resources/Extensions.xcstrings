{
  "sourceLanguage": "en",
  "strings": {
    "%@ at %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ at %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，版本 %@"
          }
        }
      }
    },
    "%@ doesn't contain a Raycast extension (no package.json with commands).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中不包含 Raycast 扩展（缺少含命令的 package.json）。"
          }
        }
      }
    },
    "%@ doesn't contain a Raycast extension manifest.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中不包含 Raycast 扩展清单。"
          }
        }
      }
    },
    "%@ doesn't support macOS.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支持 macOS。"
          }
        }
      }
    },
    "%@ has no built bundle — reinstall the extension.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有已构建的包，请重新安装该扩展。"
          }
        }
      }
    },
    "%@ has no built command bundles. Tinycast installs prebuilt extensions — run `ray build` in the extension folder first, or import one from an installed Raycast.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有已构建的命令包。Tinycast 安装预构建的扩展，请先在扩展文件夹中运行 `ray build`，或从已安装的 Raycast 导入。"
          }
        }
      }
    },
    "%@ installs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 次安装"
          }
        }
      }
    },
    "%@ is not supported in Tinycast extensions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast 扩展不支持 %@。"
          }
        }
      }
    },
    "%@ isn't supported yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未支持 %@"
          }
        }
      }
    },
    "%@ on its default branch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的默认分支"
          }
        }
      }
    },
    "%@ — required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 必填"
          }
        }
      }
    },
    "%lld commands": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个命令"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld command"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld commands"
                }
              }
            }
          }
        }
      }
    },
    "%lld items": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个项目"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld items"
                }
              }
            }
          }
        }
      }
    },
    "%lld new extensions are selected. Selecting an installed extension updates it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已勾选 %lld 个新扩展。勾选已安装的扩展会更新它。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld new extension are selected. Selecting an installed extension updates it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld new extensions are selected. Selecting an installed extension updates it."
                }
              }
            }
          }
        }
      }
    },
    "%lld not here yet — %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld not here yet — %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个尚不可用 —— %@。"
          }
        }
      }
    },
    "A folder with package.json and built commands.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含 package.json 和已构建命令的文件夹。"
          }
        }
      }
    },
    "A menu bar command must render MenuBarExtra or null.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏命令必须渲染 MenuBarExtra 或 null。"
          }
        }
      }
    },
    "A view command cannot run in the background.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带界面的命令无法在后台运行。"
          }
        }
      }
    },
    "Action": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "All Symbols": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有符号"
          }
        }
      }
    },
    "Already installed. Reinstalling replaces it with the store's copy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装。重新安装会用商店版本替换当前副本。"
          }
        }
      }
    },
    "Are you sure?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定吗？"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Background refresh": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台刷新"
          }
        }
      }
    },
    "Background refresh is off — enable it from Actions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台刷新已关闭 —— 可在「操作」中开启"
          }
        }
      }
    },
    "Building…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在构建…"
          }
        }
      }
    },
    "Builds %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建 %@。"
          }
        }
      }
    },
    "Builds an extension from source on this Mac. Only the build is kept — the source and its dependencies are deleted once it installs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机从源码构建扩展。仅保留构建结果，安装完成后删除源码及其依赖。"
          }
        }
      }
    },
    "Builds from source with your package manager.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的包管理器从源码构建。"
          }
        }
      }
    },
    "Bun": {
      "shouldTranslate": false
    },
    "By name, or by what it does — “colour”, “github”, “window”.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可按名称或用途搜索，例如 “colour”、“github”、“window”。"
          }
        }
      }
    },
